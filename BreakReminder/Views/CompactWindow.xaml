<Window x:Class="BreakReminder.Views.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False"
        Width="180" Height="52"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder" CornerRadius="14" Padding="14,6"
            Background="#CC1E1E2E"
            MouseEnter="OnMouseEnterRoot" MouseLeave="OnMouseLeaveRoot"
            MouseLeftButtonDown="OnRootMouseDown" MouseMove="OnRootMouseMove"
            MouseLeftButtonUp="OnRootMouseUp">
        <Grid>
            <!-- Hover: 锁定按钮 (左) -->
            <Button x:Name="LockButton" Content="🔓" FontSize="14"
                    Width="26" Height="26" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" Foreground="#A0A0B8"
                    BorderThickness="0" Cursor="Hand"
                    Opacity="0" IsHitTestVisible="False"
                    Click="OnLockToggle" ToolTip="锁定位置"/>

            <!-- 倒计时文字 (始终可见) -->
            <TextBlock x:Name="CountdownText"
                       Text="45:00" FontSize="22" FontWeight="Bold"
                       Foreground="#FF6B6B"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Hover: 返回按钮 (右, 仅解锁时可见) -->
            <Button x:Name="ExpandButton" Content="⬜" FontSize="12"
                    Width="26" Height="26" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" Foreground="#A0A0B8"
                    BorderThickness="0" Cursor="Hand"
                    Opacity="0" IsHitTestVisible="False"
                    Click="OnExpandClick" ToolTip="返回主窗口"/>
        </Grid>
    </Border>
</Window>

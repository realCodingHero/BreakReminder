<Window x:Class="BreakReminder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄闹钟 - 设置"
        Width="480" Height="700" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- ── 色彩 ── -->
        <SolidColorBrush x:Key="AccentBrush"     Color="#FF6B6B"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8787"/>
        <SolidColorBrush x:Key="BgCard"           Color="#2A2A3D"/>
        <SolidColorBrush x:Key="FgPrimary"        Color="#EAEAEA"/>
        <SolidColorBrush x:Key="FgSecondary"      Color="#A0A0B8"/>
        <SolidColorBrush x:Key="BorderSubtle"     Color="#3A3A50"/>

        <!-- ── 分组标题样式 ── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize"     Value="15"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,12,0,5"/>
        </Style>

        <!-- ── CheckBox 样式 ── -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,4"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>

        <!-- ── 主按钮样式 ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="28,10"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 次级按钮样式 ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource FgPrimary}"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="Padding"     Value="28,10"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Slider 样式 ── -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
            <Setter Property="Minimum"     Value="5"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="Height"      Value="22"/>
            <Setter Property="Margin"      Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <!-- ── 窗口内容 ── -->
    <Border CornerRadius="0" Padding="28,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="🍅" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="设置" Foreground="{StaticResource FgPrimary}"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 滚动内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
                <StackPanel>

                    <!-- ═══ 计时设置 ═══ -->
                    <TextBlock Text="⏱ 计时设置" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                        <StackPanel>
                            <!-- 工作时长 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="工作时长（分钟）" Foreground="{StaticResource FgPrimary}" FontSize="13"/>
                                    <Slider Style="{StaticResource ModernSlider}" Maximum="120"
                                            Value="{Binding WorkDurationMinutes, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding WorkDurationMinutes}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 休息时长 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="休息时长（分钟）" Foreground="{StaticResource FgPrimary}" FontSize="13"/>
                                    <Slider Style="{StaticResource ModernSlider}" Maximum="30"
                                            Value="{Binding BreakDurationMinutes, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding BreakDurationMinutes}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 空闲阈值 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="空闲阈值（分钟）" Foreground="{StaticResource FgPrimary}" FontSize="13"/>
                                    <Slider Style="{StaticResource ModernSlider}" Maximum="30"
                                            Value="{Binding IdleThresholdMinutes, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding IdleThresholdMinutes}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 推迟时长 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="推迟时长（分钟）" Foreground="{StaticResource FgPrimary}" FontSize="13"/>
                                    <Slider Style="{StaticResource ModernSlider}" Maximum="30"
                                            Value="{Binding SnoozeDurationMinutes, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SnoozeDurationMinutes}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 提醒方式 + 监控项目 (并排) ═══ -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 左列: 提醒方式 -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="🔔 提醒方式" Style="{StaticResource SectionHeader}"/>
                        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="Toast 通知"
                                          IsChecked="{Binding EnableToastNotification, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="弹窗提醒"
                                          IsChecked="{Binding EnablePopupWindow, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="声音提醒"
                                          IsChecked="{Binding EnableSound, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- 右列: 监控项目 -->
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="👁 监控项目" Style="{StaticResource SectionHeader}"/>
                        <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="键盘输入"
                                          IsChecked="{Binding MonitorKeyboard, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="鼠标移动"
                                          IsChecked="{Binding MonitorMouse, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="媒体播放"
                                          IsChecked="{Binding MonitorMediaPlayback, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══ 其他 ═══ -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                        <CheckBox Style="{StaticResource ModernCheckBox}" Content="⚙ 开机自动启动"
                                  IsChecked="{Binding AutoStart, Mode=TwoWay}"/>  
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
